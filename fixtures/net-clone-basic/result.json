{
  "name": "net-clone-basic",
  "covers": [
    "net.clone"
  ],
  "steps": [
    {
      "srv": [
        "init",
        "-q",
        "--bare",
        "r.git"
      ],
      "exit": 0
    },
    {
      "seed": [
        "init",
        "-q",
        "-b",
        "master"
      ],
      "exit": 0
    },
    {
      "seedWrite": "a.txt"
    },
    {
      "seedWrite": "dir/b.txt"
    },
    {
      "seed": [
        "add",
        "."
      ],
      "exit": 0
    },
    {
      "seed": [
        "commit",
        "-q",
        "-m",
        "first"
      ],
      "exit": 0
    },
    {
      "seedWrite": "a.txt"
    },
    {
      "seed": [
        "commit",
        "-q",
        "-am",
        "second"
      ],
      "exit": 0
    },
    {
      "seed": [
        "branch",
        "side"
      ],
      "exit": 0
    },
    {
      "seed": [
        "push",
        "-q",
        "{AUTH}/r.git",
        "master",
        "side"
      ],
      "exit": 0
    },
    {
      "git": [
        "clone",
        "{URL}/r.git",
        "c"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "Cloning into 'c'...\n",
      "exit": 0
    },
    {
      "git": [
        "log",
        "--oneline"
      ],
      "cwd": "c",
      "stdout": "5236856 second\nfcc6c44 first\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "status"
      ],
      "cwd": "c",
      "stdout": "On branch master\nYour branch is up to date with 'origin/master'.\n\nnothing to commit, working tree clean\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "status",
        "-sb"
      ],
      "cwd": "c",
      "stdout": "## master...origin/master\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "branch",
        "-a"
      ],
      "cwd": "c",
      "stdout": "* master\n  remotes/origin/HEAD -> origin/master\n  remotes/origin/master\n  remotes/origin/side\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "branch",
        "-r"
      ],
      "cwd": "c",
      "stdout": "  origin/HEAD -> origin/master\n  origin/master\n  origin/side\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "branch",
        "-vv"
      ],
      "cwd": "c",
      "stdout": "* master 5236856 [origin/master] second\n",
      "stderr": "",
      "exit": 0
    }
  ],
