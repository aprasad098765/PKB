{
  "name": "checkout-branches",
  "covers": [
    "cmd.checkout-switch",
    "refs.files"
  ],
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "write": "a.txt"
    },
    {
      "write": "dir/b.txt"
    },
    {
      "git": [
        "add",
        "."
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "first"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "checkout",
        "-b",
        "feature"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "Switched to a new branch 'feature'\n",
      "exit": 0
    },
    {
      "write": "f.txt"
    },
    {
      "git": [
        "add",
        "f.txt"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "on feature"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "checkout",
        "master"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "Switched to branch 'master'\n",
      "exit": 0
    },
    {
      "git": [
        "checkout",
        "master"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "Already on 'master'\n",
      "exit": 0
    },
    {
      "git": [
        "checkout",
        "feature"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "Switched to branch 'feature'\n",
      "exit": 0
    },
    {
      "git": [
        "checkout",
        "nosuch"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "error: pathspec 'nosuch' did not match any file(s) known to git\n",
      "exit": 1
    },
    {
      "git": [
        "checkout",
        "-b",
        "feature"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "fatal: a branch named 'feature' already exists\n",
      "exit": 128
    }
  ],
