        "-a",
        "-m",
        "two",
        "v2"
      ],
      "exit": 0
    },
    {
      "seed": [
        "push",
        "-q",
        "{AUTH}/r.git",
        "v2",
        ":side"
      ],
      "exit": 0
    },
    {
      "git": [
        "fetch"
      ],
      "cwd": "c",
      "stdout": "",
      "stderr": "From http://<HOST>/r\n * [new tag]         v2         -> v2\n",
      "exit": 0
    },
    {
      "git": [
        "fetch",
        "--prune"
      ],
      "cwd": "c",
      "stdout": "",
      "stderr": "From http://<HOST>/r\n - [deleted]         (none)     -> origin/side\n",
      "exit": 0
    },
    {
      "git": [
        "branch",
        "-a"
      ],
      "cwd": "c",
      "stdout": "* master\n  remotes/origin/HEAD -> origin/master\n  remotes/origin/master\n",
