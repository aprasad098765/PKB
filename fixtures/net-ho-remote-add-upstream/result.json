{
  "name": "net-ho-remote-add-upstream",
  "covers": [
    "net.push",
    "net.remote"
  ],
  "steps": [
    {
      "srv": [
        "init",
        "-q",
        "--bare",
        "p.git"
      ],
      "exit": 0
    },
    {
      "git": [
        "init",
        "-q",
        "w"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "write": "w/a"
    },
    {
      "git": [
        "add",
        "a"
      ],
      "cwd": "w",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "a"
      ],
      "cwd": "w",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "push"
      ],
      "cwd": "w",
      "stdout": "",
      "stderr": "fatal: No configured push destination.\nEither specify the URL from the command-line or configure a remote repository using\n\n    git remote add <name> <url>\n\nand then push using the remote name\n\n    git push <name>\n\n",
      "exit": 128
    },
    {
      "git": [
        "remote",
        "add",
        "origin",
        "{AUTH}/p.git"
      ],
      "cwd": "w",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "remote",
        "-v"
      ],
      "cwd": "w",
      "stdout": "origin\thttp://<CRED>@<HOST>/p.git (fetch)\norigin\thttp://<CRED>@<HOST>/p.git (push)\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "remote"
      ],
      "cwd": "w",
      "stdout": "origin\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "push"
      ],
      "cwd": "w",
      "stdout": "",
      "stderr": "fatal: The current branch master has no upstream branch.\nTo push the current branch and set the remote as upstream, use\n\n    git push --set-upstream origin master\n\nTo have this happen automatically for branches without a tracking\nupstream, see 'push.autoSetupRemote' in 'git help config'.\n\n",
      "exit": 128
    },
    {
      "git": [
        "push",
        "-u",
        "origin",
        "master"
      ],
      "cwd": "w",
      "stdout": "branch 'master' set up to track 'origin/master'.\n",
      "stderr": "To http://<HOST>/p.git\n * [new branch]      master -> master\n",
      "exit": 0
    },
    {
      "git": [
        "status",
        "-sb"
      ],
      "cwd": "w",
      "stdout": "## master...origin/master\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "checkout",
        "-q",
        "-b",
        "topic"
      ],
      "cwd": "w",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "push"
      ],
      "cwd": "w",
      "stdout": "",
      "stderr": "fatal: The current branch topic has no upstream branch.\nTo push the current branch and set the remote as upstream, use\n\n    git push --set-upstream origin topic\n\nTo have this happen automatically for branches without a tracking\nupstream, see 'push.autoSetupRemote' in 'git help config'.\n\n",
      "exit": 128
    },
    {
      "git": [
        "push",
        "origin",
        "HEAD:refs/heads/other"
      ],
      "cwd": "w",
      "stdout": "",
      "stderr": "To http://<HOST>/p.git\n * [new branch]      HEAD -> other\n",
      "exit": 0
    },
    {
      "git": [
        "branch",
        "-vv"
      ],
      "cwd": "w",
      "stdout": "  master c6cbed1 [origin/master] a\n* topic  c6cbed1 a\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "branch",
        "-u",
        "origin/other"
      ],
      "cwd": "w",
      "stdout": "branch 'topic' set up to track 'origin/other'.\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "branch",
        "-vv"
      ],
      "cwd": "w",
      "stdout": "  master c6cbed1 [origin/master] a\n* topic  c6cbed1 [origin/other] a\n",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "status"
      ],
      "cwd": "w",
      "stdout": "On branch topic\nYour branch is up to date with 'origin/other'.\n\nnothing to commit, working tree clean\n",
      "stderr": "",
      "exit": 0
    }
  ],
