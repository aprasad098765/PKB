{
  "name": "switch-branches",
  "covers": [
    "cmd.checkout-switch"
  ],
  "steps": [
    {
      "git": [
        "init",
        "-q"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "write": "a.txt"
    },
    {
      "write": "dir/b.txt"
    },
    {
      "git": [
        "add",
        "."
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "commit",
        "-q",
        "-m",
        "first"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "switch",
        "-c",
        "topic"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "Switched to a new branch 'topic'\n",
      "exit": 0
    },
    {
      "write": "dir/b.txt"
    },
    {
      "git": [
        "commit",
        "-q",
        "-am",
        "topic change"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "",
      "exit": 0
    },
    {
      "git": [
        "switch",
        "master"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "Switched to branch 'master'\n",
      "exit": 0
    },
    {
      "git": [
        "switch",
        "master"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "Already on 'master'\n",
      "exit": 0
    },
    {
      "git": [
        "switch",
        "nosuch"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "fatal: invalid reference: nosuch\n",
      "exit": 128
    },
    {
      "git": [
        "switch",
        "-c",
        "topic"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "fatal: a branch named 'topic' already exists\n",
      "exit": 128
    },
    {
      "git": [
        "switch",
        "topic"
      ],
      "cwd": ".",
      "stdout": "",
      "stderr": "Switched to branch 'topic'\n",
      "exit": 0
    }
  ],
